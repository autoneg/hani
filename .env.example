# HANI Authentication Configuration
# =================================

# Authentication Mode
# -------------------
# Options: 'auto', 'password', 'oauth'
# - 'auto': Uses OAuth if credentials are set, otherwise password auth (recommended)
# - 'password': Always use password authentication (good for local development)
# - 'oauth': Always use OAuth (requires credentials below)
HANI_AUTH_MODE=auto

# OAuth Configuration (for production/deployment)
# -----------------------------------------------
# Get these credentials from your OAuth provider:
#
# GitHub OAuth:
#   1. Go to: https://github.com/settings/developers
#   2. Click "New OAuth App"
#   3. Set Authorization callback URL to: http://localhost:5006 (or your domain)
#   4. Copy Client ID and generate a Client Secret
#
# Google OAuth:
#   1. Go to: https://console.cloud.google.com/apis/credentials
#   2. Create OAuth 2.0 Client ID
#   3. Add authorized redirect URI: http://localhost:5006/oauth-callback
#
HANI_OAUTH_PROVIDER=github
HANI_OAUTH_KEY=your-github-client-id-here
HANI_OAUTH_SECRET=your-github-client-secret-here
HANI_OAUTH_REDIRECT_URI=http://localhost:5006

# Cookie Secret (for session management)
# --------------------------------------
# Generate a secure random string for production:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
HANI_COOKIE_SECRET=hani-super-secret-co-4653322hjhj

# Usage Examples
# ==============
#
# Local Development (password auth):
#   - Don't set HANI_OAUTH_KEY/SECRET, or set HANI_AUTH_MODE=password
#   - Run: hani --dev
#   - Login with credentials from ~/negmas/hani/settings/users_hashed.json
#
# Production (OAuth):
#   - Set HANI_OAUTH_KEY and HANI_OAUTH_SECRET from your OAuth provider
#   - Run: hani
#   - Users login via GitHub/Google/etc
#
# Force specific mode:
#   export HANI_AUTH_MODE=oauth  # Force OAuth
#   export HANI_AUTH_MODE=password  # Force password
#
